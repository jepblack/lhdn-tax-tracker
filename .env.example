# Optional: Supabase (leave blank to run in Local Browser Preview Mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Groq API Key for fast (~1s) free-tier Llama 4 Scout Vision (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# Optional: Google Gemini API Key for AI receipt scanning (OCR + LHDN category matching)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Monetization & Malaysia Payment Gateways (falls back to instant sandbox if blank)
STRIPE_SECRET_KEY=your-stripe-secret-key
BILLPLZ_API_KEY=your-billplz-api-key
BILLPLZ_COLLECTION_ID=your-billplz-collection-id
CHIP_SECRET_KEY=your-chip-secret-key
CHIP_BRAND_ID=your-chip-brand-id
