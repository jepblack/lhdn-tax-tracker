{
  "name": "CukaiKu — LHDN Tax Relief & Receipt Manager",
  "short_name": "CukaiKu",
  "description": "Personal Malaysia LHDN tax relief tracker, sub-limit maximizer, and 7-year receipt vault.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F6F8FA",
  "theme_color": "#F6F8FA",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan Receipt / e-Invoice",
      "short_name": "Scan Receipt",
      "description": "Snap a receipt or scan an LHDN MyInvois QR code",
      "url": "/?scan=camera",
      "icons": [
        {
          "src": "/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Scan MyInvois QR",
      "short_name": "MyInvois QR",
      "description": "Validate and attach LHDN MyInvois e-Invoice QR",
      "url": "/?scan=qr",
      "icons": [
        {
          "src": "/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/?shared=1",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
